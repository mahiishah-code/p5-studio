# Example global crushrc. It lives in your HOME folder, never in a repo:
#   macOS / Linux:  ~/.config/crush/crushrc
#   Windows:        %USERPROFILE%\.config\crush\crushrc
#
# Replace MODEL with the vision model from the course announcement, and the
# paths with the absolute paths on your machine. `npm run vision-check`
# prints the provider and model lines for you, filled in.

# BayLeaf, an OpenAI-compatible API. The key comes from the BAYLEAF_API_KEY
# environment variable, so it never appears in this file.
provider add bayleaf --name BayLeaf --type openai-compat \
  --base-url "https://api.bayleaf.dev/v1" \
  --api-key "${BAYLEAF_API_KEY:?set BAYLEAF_API_KEY}"

# --supports-images true is REQUIRED for this course. Without it, Crush
# throws away every image an MCP tool returns, and the agent is blind.
model add bayleaf/openrouter:MODEL --name "MODEL" \
  --context-window 32000 --default-max-tokens 8000 --supports-images true

model large bayleaf/openrouter:MODEL

# MCP servers: the one from the MCP assignment, and the p5 studio.
mcp add auglab-tools --command node --args "C:/Users/you/mcp-server-a3/index.js"
mcp add p5-studio --command node --args "C:/Users/you/p5-studio/server.js"
